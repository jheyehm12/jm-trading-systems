---
import { homeQaExperience } from '../../data/projects';
import '../../styles/global.css';
---

<html lang="en" class="bg-page-bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>QA & Validation — JM Trading Systems</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" />
  </head>
  <body class="bg-page-bg font-body text-body-strong antialiased">
    <main class="site-shell min-h-screen overflow-x-clip px-4 py-10 sm:px-6 sm:py-14 md:px-8 lg:px-12">
      <div class="mx-auto max-w-4xl">
        <a href="/#validation-background" class="text-sm text-body-soft hover:text-accent-blue">← Back home</a>
        <h1 class="mt-6 font-display text-[1.85rem] font-bold sm:mt-8 sm:text-3xl lg:text-4xl">QA & Validation</h1>
        <p class="mt-4 max-w-2xl leading-8 text-body-muted">
          Supporting credibility from 9+ years of software quality engineering — applied to trading systems, AI applications, and SaaS delivery. Not offered as a standalone freelance service.
        </p>
        <div class="mt-10 space-y-10">
          {homeQaExperience.map((project) => (
            <article class="border-t border-theme pt-8">
              <p class="font-display text-[11px] uppercase tracking-[0.24em] text-accent-blue">{project.category}</p>
              <h2 class="mt-3 font-display text-2xl font-semibold text-heading">{project.title}</h2>
              <p class="mt-3 leading-8 text-body-muted">{project.summary}</p>
              {project.outcome ? (
                <p class="mt-4 text-sm leading-7 text-body-soft">
                  <span class="text-body-strong">Outcome: </span>
                  {project.outcome}
                </p>
              ) : null}
              <ul class="mt-4 space-y-1.5">
                {project.features.map((feature) => (
                  <li class="text-sm leading-7 text-body-soft">– {feature}</li>
                ))}
              </ul>
              {project.tags?.length ? (
                <div class="mt-4 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="chip rounded px-2.5 py-1 text-[10px] uppercase tracking-[0.12em]">{tag}</span>
                  ))}
                </div>
              ) : null}
              <p class="mt-4 text-sm text-body-soft">{project.tools.join(' • ')}</p>
            </article>
          ))}
        </div>
      </div>
    </main>
  </body>
</html>
