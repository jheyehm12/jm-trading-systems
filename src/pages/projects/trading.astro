---
import SiteHead from '../../components/SiteHead.astro';
import { tradingProjects } from '../../data/projects';
import '../../styles/global.css';
---

<html lang="en" class="bg-page-bg">
  <head>
    <SiteHead
      title="Trading Systems"
      description="Trading systems case studies — MyAlert, LookBack, and TradeVault."
      path="/projects/trading/"
    />
  </head>
  <body class="bg-page-bg font-body text-body-strong antialiased">
    <main class="site-shell min-h-screen overflow-x-clip px-4 py-10 sm:px-6 sm:py-14 md:px-8 lg:px-12">
      <div class="mx-auto max-w-4xl">
        <a href="/#case-studies" class="text-sm text-body-soft hover:text-accent-blue">← Back to projects</a>
        <h1 class="mt-6 font-display text-[1.85rem] font-bold sm:mt-8 sm:text-3xl lg:text-4xl">Trading Systems</h1>
        <div class="mt-10 space-y-10">
          {tradingProjects.map((project) => (
            <article class="border-t border-theme pt-8">
              <p class="font-display text-[11px] uppercase tracking-[0.24em] text-accent-blue">{project.category}</p>
              <h2 class="mt-3 font-display text-2xl font-semibold text-heading">{project.title}</h2>
              {project.subtitle ? (
                <p class="mt-2 text-sm text-accent-blue">{project.subtitle}</p>
              ) : null}
              <p class="mt-3 leading-8 text-body-muted">{project.summary}</p>
              {project.detail ? (
                <p class="mt-3 leading-8 text-body-soft">{project.detail}</p>
              ) : null}
              {project.outcome ? (
                <p class="mt-4 text-sm leading-7 text-body-soft">
                  <span class="text-body-strong">Outcome: </span>
                  {project.outcome}
                </p>
              ) : null}
              <ul class="mt-4 space-y-1.5">
                {project.features.map((feature) => (
                  <li class="text-sm leading-7 text-body-soft">– {feature}</li>
                ))}
              </ul>
              {project.tags?.length ? (
                <div class="mt-4 flex flex-wrap gap-2">
                  {project.tags.map((tag) => (
                    <span class="chip rounded px-2.5 py-1 text-[10px] uppercase tracking-[0.12em]">{tag}</span>
                  ))}
                </div>
              ) : null}
              <p class="mt-4 text-sm text-body-soft">{project.tools.join(' • ')}</p>
              <div class="mt-4 flex flex-wrap gap-4">
                {project.liveUrl ? (
                  <a href={project.liveUrl} target="_blank" rel="noreferrer" class="text-sm text-accent-blue hover:opacity-80">Live Demo →</a>
                ) : null}
                {project.githubUrl ? (
                  <a href={project.githubUrl} target="_blank" rel="noreferrer" class="text-sm text-body-muted hover:text-accent-blue">GitHub →</a>
                ) : null}
                {project.demoUrl ? (
                  <a href={project.demoUrl} target="_blank" rel="noreferrer" class="text-sm text-body-muted hover:text-accent-blue">▶ Watch Demo →</a>
                ) : null}
              </div>
              {project.images?.length ? (
                <div class="mt-6 space-y-4">
                  {project.images.map((image) => (
                    <figure class="surface-panel overflow-hidden rounded-lg">
                      <img src={image.src} alt={image.caption} class="block w-full bg-[#131722]" loading="lazy" />
                      <figcaption class="border-t border-theme px-4 py-2 text-xs text-body-soft">
                        {image.caption}
                      </figcaption>
                    </figure>
                  ))}
                </div>
              ) : null}
            </article>
          ))}
        </div>
      </div>
    </main>
  </body>
</html>
