---
import { homeSelectedWork } from '../../data/projects';
import '../../styles/global.css';

const aiProjects = homeSelectedWork.filter((p) =>
  p.category.includes('AI'),
);
---

<html lang="en" class="bg-page-bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>AI & Automation — JM Trading Systems</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" />
  </head>
  <body class="bg-page-bg font-body text-white antialiased">
    <main class="site-shell min-h-screen px-6 py-16 sm:px-8 lg:px-12">
      <div class="mx-auto max-w-4xl">
        <a href="/#selected-work" class="text-sm text-body-soft hover:text-accent-blue">← Back to projects</a>
        <h1 class="mt-8 font-display text-4xl font-bold">AI & Automation</h1>
        <div class="mt-10 space-y-8">
          {aiProjects.map((project) => (
            <article class="border-t border-white/10 pt-8">
              <h2 class="font-display text-2xl font-semibold text-white">{project.title}</h2>
              <p class="mt-3 leading-8 text-body-muted">{project.summary}</p>
              {project.liveUrl ? (
                <a href={project.liveUrl} target="_blank" rel="noreferrer" class="mt-3 inline-block text-sm text-accent-blue hover:underline">
                  Live app →
                </a>
              ) : null}
            </article>
          ))}
        </div>
      </div>
    </main>
  </body>
</html>
