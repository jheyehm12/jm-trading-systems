---
import { tradingProjects } from '../../data/projects';
import '../../styles/global.css';

const tradevault = tradingProjects.find((p) => p.id === 'tradevault');
---

<html lang="en" class="bg-page-bg">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Full Stack SaaS — JM Trading Systems</title>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&display=swap" />
  </head>
  <body class="bg-page-bg font-body text-body-strong antialiased">
    <main class="site-shell min-h-screen overflow-x-clip px-4 py-10 sm:px-6 sm:py-14 md:px-8 lg:px-12">
      <div class="mx-auto max-w-4xl">
        <a href="/#selected-work" class="text-sm text-body-soft hover:text-accent-blue">← Back to projects</a>
        <h1 class="mt-6 font-display text-[1.85rem] font-bold sm:mt-8 sm:text-3xl lg:text-4xl">Full Stack SaaS</h1>
        {tradevault ? (
          <article class="mt-10 border-t border-theme pt-8">
            <h2 class="font-display text-2xl font-semibold text-heading">{tradevault.title}</h2>
            {tradevault.subtitle ? (
              <p class="mt-2 text-sm text-accent-blue">{tradevault.subtitle}</p>
            ) : null}
            <p class="mt-3 leading-8 text-body-muted">{tradevault.summary}</p>
            {tradevault.outcome ? (
              <p class="mt-4 text-sm leading-7 text-body-soft">
                <span class="text-body-strong">Outcome: </span>
                {tradevault.outcome}
              </p>
            ) : null}
            <p class="mt-4 text-sm text-body-soft">{tradevault.tools.join(' • ')}</p>
            <div class="mt-4 flex flex-wrap gap-4">
              {tradevault.liveUrl ? (
                <a href={tradevault.liveUrl} target="_blank" rel="noreferrer" class="text-sm text-accent-blue hover:opacity-80">Live Demo →</a>
              ) : null}
              {tradevault.githubUrl ? (
                <a href={tradevault.githubUrl} target="_blank" rel="noreferrer" class="text-sm text-body-muted hover:text-accent-blue">GitHub →</a>
              ) : null}
              {tradevault.demoUrl ? (
                <a href={tradevault.demoUrl} target="_blank" rel="noreferrer" class="text-sm text-body-muted hover:text-accent-blue">▶ Watch Demo →</a>
              ) : null}
            </div>
            <a href="/projects/trading/" class="mt-6 inline-block text-sm text-body-muted hover:text-accent-blue">View all trading systems →</a>
          </article>
        ) : null}
      </div>
    </main>
  </body>
</html>
