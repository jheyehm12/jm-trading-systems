---
import CaseStudySection from '../components/CaseStudySection';
import ContactCTASection from '../components/ContactCTASection';
import JMFooter from '../components/JMFooter';
import JMHeroShell from '../components/JMHeroShell';
import SelectedWorkSection from '../components/SelectedWorkSection';
import SiteHead from '../components/SiteHead.astro';
import StatsSection from '../components/StatsSection';
import TestimonialsSection from '../components/TestimonialsSection';
import ValidationBackgroundSection from '../components/ValidationBackgroundSection';
import WhatIBuildSection from '../components/WhatIBuildSection';
import { homeCaseStudies, homeQaExperience, homeSelectedWork } from '../data/projects';
import {
  contactAvailability,
  footerDirectory,
  footerMeta,
  footerPolicies,
  heroContent,
  heroLeftNav,
  heroRightNav,
  mobileNav,
  stats,
  testimonials,
  validationBackground,
  whatIBuild,
} from '../data/site';
import '../styles/global.css';
---

<html lang="en" class="bg-page-bg">
  <head>
    <SiteHead path="/" />
  </head>
  <body class="bg-page-bg font-body text-body-strong antialiased">
    <main class="site-shell overflow-x-clip">
      <JMHeroShell
        client:load
        content={heroContent}
        leftNav={heroLeftNav}
        mobileNav={mobileNav}
        rightNav={heroRightNav}
      />
      <CaseStudySection client:visible projects={homeCaseStudies} />
      <SelectedWorkSection client:visible projects={homeSelectedWork} />
      <StatsSection client:visible stats={stats} />
      <WhatIBuildSection client:visible groups={whatIBuild} />
      <TestimonialsSection client:visible items={testimonials} />
      <ValidationBackgroundSection
        client:visible
        content={validationBackground}
        qaProjects={homeQaExperience}
      />
      <ContactCTASection client:visible items={contactAvailability} />
      <JMFooter
        client:visible
        directory={footerDirectory}
        meta={footerMeta}
        policies={footerPolicies}
      />
    </main>
  </body>
</html>
