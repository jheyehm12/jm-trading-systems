---
import HomeAbout from '../components/home/HomeAbout.astro';
import HomeContact from '../components/home/HomeContact.astro';
import HomeExpertise from '../components/home/HomeExpertise.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeNav from '../components/home/HomeNav.astro';
import HomeWork from '../components/home/HomeWork.astro';
import SiteHead from '../components/SiteHead.astro';
import '../styles/global.css';
import '../styles/home.css';

const description =
  'Jimeno Labs is an AI systems & engineering studio by John Michael Jimeno — AI systems, automation, integration, and quality engineering, with trading as a specialization.';
---

<html lang="en">
  <head>
    <SiteHead path="/" description={description} />
    <!-- Flags JS so scroll-reveal only hides content when it can be revealed again. -->
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="jl">
    <HomeNav />
    <main>
      <HomeHero />
      <HomeWork />
      <HomeExpertise />
      <HomeAbout />
      <HomeContact />
    </main>
  </body>
</html>
