---
import HomeFooter from '../components/home/HomeFooter.astro';
import HomeNav from '../components/home/HomeNav.astro';
import SiteHead from '../components/SiteHead.astro';
import { homeExpertise } from '../data/home';
import { contactEmail } from '../data/site';
import '../styles/global.css';
import '../styles/home.css';

// Core studio services first; trading stays a secondary specialization.
const services = homeExpertise.areas.slice(0, 4);
const secondary = homeExpertise.areas[4];
const githubUrl = 'https://github.com/jheyehm12';
---

<html lang="en">
  <head>
    <SiteHead
      title="Contact"
      description="Contact Jimeno Labs, an AI systems & engineering studio — full-stack development, AI applications, automation and quality engineering for freelance and consulting engagements."
      path="/contact/"
    />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body class="jl">
    <HomeNav onContact />
    <main class="jl-cp" id="main">
      <div class="jl-wrap jl-cp__grid">
        <div class="jl-cp__lead">
          <p class="jl-eyebrow jl-cp__eyebrow jl-cp__in" style="--d: 0.05s">Contact</p>
          <h1 class="jl-cp__title">
            <span class="jl-cp__line"><span style="--i: 0">Let's build</span></span>
            <span class="jl-cp__line"><span style="--i: 1">something</span></span>
            <span class="jl-cp__line"><span style="--i: 2"><em>meaningful.</em></span></span>
          </h1>
          <p class="jl-cp__intro jl-cp__in" style="--d: 0.55s">
            Jimeno Labs is an AI systems & engineering studio. Available for freelance projects and consulting
            engagements — tell me what you are building and where it needs to be reliable.
          </p>
          <div class="jl-cp__cta jl-cp__in" style="--d: 0.7s">
            <a href={`mailto:${contactEmail}`} class="jl-btn jl-btn--dark">Send an Email</a>
            <a href="/#work" class="jl-btn jl-btn--outline">Explore Work</a>
          </div>
          <p class="jl-cp__direct jl-cp__in" style="--d: 0.8s">
            <a href={`mailto:${contactEmail}`}>{contactEmail}</a>
            <span aria-hidden="true">·</span>
            <a href={githubUrl} target="_blank" rel="noreferrer">GitHub profile</a>
          </p>
        </div>

        <div class="jl-cp__side jl-cp__in" style="--d: 0.45s">
          <p class="jl-eyebrow jl-cp__eyebrow">How I can help</p>
          <ol class="jl-expertise__list jl-cp__list">
            {
              services.map((area, i) => (
                <li class="jl-area">
                  <span class="jl-area__num">{String(i + 1).padStart(2, '0')}</span>
                  <h2>{area.title}</h2>
                  <p>{area.text}</p>
                </li>
              ))
            }
          </ol>
          <p class="jl-cp__also">Also: {secondary.title.toLowerCase()} — {secondary.text}</p>
        </div>
      </div>
    </main>
    <HomeFooter base="/" />
  </body>
</html>
