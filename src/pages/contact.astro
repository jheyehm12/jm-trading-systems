---
import SiteHead from '../components/SiteHead.astro';
import { contactAvailability, siteBrand, workWithMeMessage } from '../data/site';
import '../styles/global.css';

const githubUrl = 'https://github.com/jheyehm12';
---

<html lang="en" class="bg-page-bg">
  <head>
    <SiteHead
      title="Work With Me"
      description={`Work with ${siteBrand} — freelance projects and consulting engagements.`}
      path="/contact/"
    />
  </head>
  <body class="bg-page-bg font-body text-body-strong antialiased">
    <main class="site-shell min-h-screen overflow-x-clip px-4 py-10 sm:px-6 sm:py-14 md:px-8 lg:px-12">
      <div class="mx-auto max-w-3xl">
        <a href="/" class="inline-flex items-center text-sm text-body-soft transition-colors hover:text-accent-blue">
          ← Back home
        </a>
        <div class="surface-panel mt-6 rounded-lg p-5 sm:mt-8 sm:p-8 lg:p-10">
          <span class="font-display text-lg font-semibold text-body-strong">{siteBrand}</span>
          <p class="mt-6 font-display text-[11px] uppercase tracking-[0.24em] text-accent-blue">
            Work With Me
          </p>
          <h1 class="mt-4 font-display text-[1.75rem] font-bold tracking-[-0.03em] text-heading sm:text-3xl">
            Let&apos;s talk about your next project.
          </h1>
          <p class="mt-4 text-base leading-8 text-body-muted">
            {workWithMeMessage}
          </p>
          <div class="mt-8 flex flex-wrap gap-2">
            {contactAvailability.map((item) => (
              <span class="chip rounded px-3 py-1.5 text-sm">
                {item}
              </span>
            ))}
          </div>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a
              href={githubUrl}
              target="_blank"
              rel="noreferrer"
              class="btn-primary"
            >
              Connect on GitHub
            </a>
            <a
              href="/#case-studies"
              class="btn-secondary"
            >
              View Projects
            </a>
          </div>
        </div>
      </div>
    </main>
  </body>
</html>
